{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["context-mode", "superpowers@git+https://github.com/obra/superpowers.git"],
  "instructions": [
    "AGENTS.md"
  ],
  "references": {
    "nuxt": {
      "repository": "nuxt/nuxt",
      "branch": "v4.4.7",
      "description": "Nuxt framework source — use for core framework behavior, rendering modes, and module APIs"
    },
    "nuxt-ui": {
      "repository": "nuxt/ui",
      "branch": "v4.8.1",
      "description": "Nuxt UI component library — use for component props, theming, and usage examples"
    },
    "effect": {
      "repository": "Effect-TS/effect",
      "branch": "effect@3.21.2",
      "description": "Effect-TS runtime — use for Effect, Layer, Context.Tag, and error handling patterns"
    },
    "supabase-js": {
      "repository": "supabase/supabase-js",
      "branch": "v2.107.0",
      "description": "Supabase JavaScript client — use for auth, database, and realtime client APIs"
    },
    "drizzle-orm": {
      "repository": "drizzle-team/drizzle-orm",
      "branch": "beta",
      "description": "Drizzle ORM source — use for schema definitions, query syntax, and migration APIs (project uses 1.0.0-rc pre-release)"
    },
    "galaxy": {
      "repository": "galaxyproject/galaxy",
      "branch": "v26.0.1",
      "description": "Galaxy server and official TypeScript API client source — use client/packages/api-client/ for generated OpenAPI types and endpoint usage, lib/galaxy/webapps/galaxy/api/ for server-side endpoint semantics, and lib/galaxy/schema/ for request/response models."
    },
    "pinia-colada": {
      "repository": "posva/pinia-colada",
      "branch": "v1.3.1",
      "description": "Pinia Colada data fetching library — use for useQuery, defineQueryOptions, query caches, mutations, and @pinia/colada-nuxt module integration"
    },
    "nuxtjs-supabase": {
      "repository": "nuxt-modules/supabase",
      "branch": "v2.0.9",
      "description": "@nuxtjs/supabase Nuxt module — use for Supabase SSR auth, useSupabaseClient/useSupabaseUser composables, serverSupabaseServiceRole, and module configuration"
    },
    "d3-selection": {
      "repository": "d3/d3-selection",
      "branch": "v3.0.0",
      "description": "D3 selection API — use for select/selectAll, data binding, joins, transitions, and DOM manipulation patterns"
    },
    "d3-zoom": {
      "repository": "d3/d3-zoom",
      "branch": "v3.0.0",
      "description": "D3 zoom behavior — use for zoom transforms, scaleExtent, translateExtent, and pan/zoom event handling"
    },
    "d3-array": {
      "repository": "d3/d3-array",
      "branch": "v3.2.4",
      "description": "D3 array utilities — use for bin, group, rollup, extent, max/min, sort, and statistical helpers"
    },
    "uwdata-mosaic-core": {
      "repository": "uwdata/mosaic",
      "branch": "v0.26.0",
      "description": "Mosaic core — use for coordinator, DuckDB connectors, Selection, and reactive data flow"
    },
    "uwdata-mosaic-sql": {
      "repository": "uwdata/mosaic",
      "branch": "v0.26.0",
      "description": "Mosaic SQL utilities — use for query building, SQL helpers, and database expression generation"
    },
    "uwdata-vgplot": {
      "repository": "uwdata/mosaic",
      "branch": "v0.26.0",
      "description": "Mosaic vgplot — use for declarative visualization grammars, marks, and chart specifications"
    },
    "nuxt-content": {
      "repository": "nuxt/content",
      "branch": "v3.14.0",
      "description": "@nuxt/content module — use for content collections, defineContentConfig, queryCollection, and MDX/Markdown rendering"
    },
    "nuxt-test-utils": {
      "repository": "nuxt/test-utils",
      "branch": "v4.0.3",
      "description": "@nuxt/test-utils — use for mountSuspended, setupTestUtils, and Nuxt/Vitest integration"
    },
    "vue-test-utils": {
      "repository": "vuejs/test-utils",
      "branch": "v2.4.11",
      "description": "@vue/test-utils — use for mount, shallowMount, flushPromises, and Vue component testing"
    },
    "zod": {
      "repository": "colinhacks/zod",
      "branch": "v4.4.3",
      "description": "Zod schema validation — use for z.object, z.coerce, infer, parse, and Zod v4 APIs"
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI@Pasteur",
      "options": {
        "baseURL": "https://ia.pasteur.cloud"
      },
      "models": {
        "big": {
          "name": "big"
        },
        "medium-reasoning": {
          "name": "medium-reasoning"
        },
        "medium": {
          "name": "medium"
        },
        "small": {
          "name": "small"
        }
      }
    },
    "litellm-ext": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI-ext@Pasteur",
      "options": {
        "baseURL": "https://ia-ext.pasteur.cloud"
      },
      "models": {
        "anthropic/claude-opus-4-6": {
          "name": "anthropic/claude-opus-4-6"
        }
      }
    }
  },
  "mcp": {
    "nuxt": {
      "type": "remote",
      "url": "https://nuxt.com/mcp",
      "enabled": true
    },
    "nuxt-ui": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp",
      "enabled": true
    },
    "nuxt-seo": {
      "type": "remote",
      "url": "https://nuxtseo.com/mcp",
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
