{
  "name": "@gaas/wiki",
  "type": "module",
  "version": "0.0.4-beta.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rplanel/GaaS.git",
    "directory": "packages/wiki"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "content.config.ts",
    "nuxt.config.ts",
    "server"
  ],
  "scripts": {
    "dev": "nuxi dev .playground",
    "dev:prepare": "nuxt prepare .playground",
    "build": "nuxt build .playground",
    "generate": "nuxt generate .playground",
    "preview": "nuxt preview .playground",
    "lint": "eslint .",
    "test": "vitest run",
    "release:publish": "pnpm publish --access public",
    "release:publish:beta": "pnpm publish --access public --tag beta",
    "typecheck": "vue-tsc --noEmit",
    "cleandep": "rm -rf node_modules .data .nuxt .playground/.nuxt .playground/.output .playground/node_modules .playground/.data"
  },
  "dependencies": {
    "@gaas/ui": "workspace:^",
    "@nuxt/content": "catalog:nuxt",
    "@nuxt/eslint": "catalog:nuxt",
    "@nuxt/kit": "catalog:nuxt",
    "@nuxt/ui": "catalog:nuxt",
    "@vueuse/core": "catalog:",
    "better-sqlite3": "catalog:",
    "evlog": "catalog:",
    "nuxt-galaxy": "workspace:*",
    "nuxt-studio": "catalog:nuxt",
    "zod": "catalog:",
    "zod-validation-error": "catalog:"
  },
  "devDependencies": {
    "@nuxt/test-utils": "catalog:testing",
    "@vue/test-utils": "catalog:testing",
    "embla-carousel": "catalog:",
    "eslint": "catalog:",
    "h3": "catalog:",
    "happy-dom": "catalog:testing",
    "nuxt": "catalog:nuxt",
    "playwright-core": "catalog:testing",
    "typescript": "catalog:",
    "vitest": "catalog:testing",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
