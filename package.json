{
  "name": "gaas",
  "version": "0.0.4-beta.9",
  "private": true,
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "description": "",
  "author": "",
  "license": "MIT",
  "keywords": [],
  "scripts": {
    "postinstall": "node scripts/repos/postinstall.mjs",
    "repos": "node scripts/repos/download.mts",
    "test": "pnpm --filter './packages/**' test",
    "dev": "pnpm run supabase:start && pnpm --filter ./playground dev",
    "lint": "pnpm --filter './packages/**' lint",
    "cleandep": "rm -rf node_modules pnpm-lock.yaml && pnpm --filter '**' run cleandep && pnpm install",
    "build": "pnpm --filter './packages/**' prepack",
    "dev:prepare": "pnpm --filter './packages/**' run dev:prepare",
    "typecheck": "pnpm --filter './packages/**' run typecheck",
    "docs:dev": "pnpm --filter ./docs dev",
    "docs:build": "pnpm --filter ./docs build",
    "docs:generate": "pnpm --filter ./docs generate",
    "release:check": "pnpm run build && pnpm run dev:prepare && pnpm run lint && pnpm run typecheck && pnpm run test && node --test 'scripts/*/*.test.mts'",
    "release": "pnpm run release:check && commit-and-tag-version --commit-all && pnpm run release:push && pnpm run release:await",
    "release:beta": "pnpm run release:check && commit-and-tag-version --commit-all --prerelease beta --release-as patch && pnpm run release:push && pnpm run release:await",
    "release:push": "node scripts/release/push.mts",
    "release:await": "node scripts/release/await-publish.mts",
    "release:dry-run": "commit-and-tag-version --dry-run",
    "release:beta:dry-run": "commit-and-tag-version --dry-run --prerelease beta --release-as patch",
    "supabase:status": "pnpm supabase --workdir packages/nuxt-galaxy status",
    "supabase:start": "pnpm supabase --workdir packages/nuxt-galaxy start",
    "supabase:stop": "pnpm supabase --workdir packages/nuxt-galaxy stop"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "commit-and-tag-version": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "msw": "catalog:testing",
    "simple-git-hooks": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "node scripts/lint-staged.mjs"
  }
}
