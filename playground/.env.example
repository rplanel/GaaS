# Galaxy API Credentials
GALAXY_URL="https://your-galaxy-instance.org"
GALAXY_API_KEY="your-galaxy-api-key"
GALAXY_EMAIL="your-email@example.com"

# Supabase
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_KEY="your-supabase-anon-key"

# Optional: for server-side operations
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Drizzle ORM Database URL (required for server-side DB operations)
# For local Supabase development:
GALAXY_DRIZZLE_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# For Supabase Cloud (use connection pooler):
# GALAXY_DRIZZLE_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Optional: GitHub OAuth (only if using GitHub auth)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Optional: Nuxt UI Pro License
# NUXT_UI_PRO_LICENSE="your-license-key"

# Optional: Additional Galaxy Instances
# UseGalaxy.eu
# GALAXY_API_KEY_2="your-api-key"
# GALAXY_URL_2="https://usegalaxy.eu"
# GALAXY_EMAIL_2="your-email@example.com"

# Optional: External services
# GIGET_GITLAB_URL="https://gitlab.example.com"
# MEILISEARCH_HOST="http://127.0.0.1:7700"
# MEILISEARCH_API_KEY="your-meilisearch-key"
# MISTRAL_API_KEY="your-mistral-api-key"
